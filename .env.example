# Frontend apps
VITE_API_URL=http://localhost:3001
VITE_PORTAL_URL=http://localhost:5174

# Express API / MySQL
NODE_ENV=development
PORT=3001
TRUST_PROXY_HOPS=1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://clockwrk.io,https://www.clockwrk.io,https://dashboard.clockwrk.io,https://my.clockwrk.io
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=clockwrk
DB_PASS=replace_me
DB_NAME=clockwrk
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_PORTAL_URL=http://localhost:5174
ALLOW_RAW_SQL=false

# Transactional email
RESEND_API_KEY=re_replace_me
RESEND_FROM=Clockwrk <hello@clockwrk.io>
INTERNAL_ALERT_EMAIL=team@clockwrk.io

# Zoom Server-to-Server OAuth used by public bookings
ZOOM_ACCOUNT_ID=replace_me
ZOOM_CLIENT_ID=replace_me
ZOOM_CLIENT_SECRET=replace_me

# Cloudflare R2 file storage
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=clockwrk
R2_ENDPOINT=https://replace_me.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://files.clockwrk.io

# Legacy n8n dashboard status route; remove after n8n decommissioning
N8N_URL=http://localhost:5678
N8N_API_KEY=replace_me

# Cloudflare tooling (CLI/deployment only; D1 and R2 runtime bindings live in wrangler config)
CLOUDFLARE_ACCOUNT_ID=replace_me
CLOUDFLARE_API_TOKEN=replace_me
