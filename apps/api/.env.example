DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=agency_db
DB_USER=agency_user
DB_PASS=your_password_here

JWT_SECRET=your_jwt_secret_here

PORT=3001

RESEND_API_KEY=re_your_resend_api_key
