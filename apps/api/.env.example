ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

ALLOWED_ORIGINS=http://localhost:5173,https://clockwrk.io,https://www.clockwrk.io,https://dashboard.clockwrk.io
